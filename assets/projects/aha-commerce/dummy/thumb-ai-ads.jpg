<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="800" height="450">
  <defs>
    <radialGradient id="bg" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#1c1c24"/>
      <stop offset="60%" stop-color="#121216"/>
      <stop offset="100%" stop-color="#09090b"/>
    </radialGradient>
    <pattern id="pat" width="30" height="30" patternUnits="userSpaceOnUse">
      <path d="M 30 0 L 0 0 0 30" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#bg)"/>
  <rect width="100%" height="100%" fill="url(#pat)"/>
  <circle cx="600" cy="112.5" r="240" fill="#F42902" opacity="0.12" filter="blur(30px)"/>
  <circle cx="200" cy="337.5" r="160" fill="#83FD80" opacity="0.05" filter="blur(25px)"/>
  
  <rect x="20" y="20" width="760" height="410" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1" rx="8"/>
  <line x1="20" y1="50" x2="780" y2="50" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
  
  <text x="35" y="40" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="700" fill="#83FD80" letter-spacing="1">AHA COMMERCE</text>
  <text x="765" y="40" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="600" fill="#A1A1AA" text-anchor="end">ALFIANSYAH</text>
  
  <text x="400" y="225" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="22" font-weight="700" fill="#FDFDFF" text-anchor="middle">Thumb Ai Ads</text>
  <text x="400" y="253" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="12" font-weight="500" fill="#A1A1AA" text-anchor="middle">DELIVERABLE ARCHIVE</text>
  
  <rect x="370" y="415" width="60" height="2" fill="#F42902" rx="1"/>
</svg>